{
  "name": "nus-canvas-sync",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun test",
    "collect": "bun run src/cli.ts collect",
    "format": "biome format --write .",
    "healthcheck": "bun run src/cli.ts healthcheck",
    "lint": "biome check .",
    "notion:export": "bun run src/cli.ts notion-export",
    "notion:schema": "bun run src/cli.ts notion-schema",
    "sync": "bun run src/cli.ts sync",
    "sync:publish": "bun run src/cli.ts sync --publish",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
