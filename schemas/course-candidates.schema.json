{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "courseCode",
          "sourceIds",
          "evidence",
          "kind",
          "title",
          "requiredAction",
          "availableFrom",
          "dueAt",
          "eventEndsAt",
          "dateEvidence",
          "confidence",
          "ambiguity",
          "reviewIssue",
          "matchTaskId",
          "logicalKey"
        ],
        "properties": {
          "courseCode": {
            "type": "string",
            "enum": ["CS2030S", "GEA1000", "GESS1001", "IS1128", "MA1301"]
          },
          "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "evidence": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["assessment", "preparation", "e-lecture", "physical-event", "optional"]
          },
          "title": { "type": "string", "minLength": 1 },
          "requiredAction": { "type": "string" },
          "availableFrom": {
            "type": ["string", "null"],
            "pattern": "^(?:\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T\\d{2}:\\d{2}(?::\\d{2}(?:\\.\\d{1,9})?)?(?:Z|[+-]\\d{2}:\\d{2}))$"
          },
          "dueAt": {
            "type": ["string", "null"],
            "pattern": "^(?:\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T\\d{2}:\\d{2}(?::\\d{2}(?:\\.\\d{1,9})?)?(?:Z|[+-]\\d{2}:\\d{2}))$"
          },
          "eventEndsAt": {
            "type": ["string", "null"],
            "pattern": "^(?:\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T\\d{2}:\\d{2}(?::\\d{2}(?:\\.\\d{1,9})?)?(?:Z|[+-]\\d{2}:\\d{2}))$"
          },
          "dateEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["availableFrom", "dueAt", "eventEndsAt"],
            "properties": {
              "availableFrom": { "$ref": "#/$defs/dateEvidence" },
              "dueAt": { "$ref": "#/$defs/dateEvidence" },
              "eventEndsAt": { "$ref": "#/$defs/dateEvidence" }
            }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "ambiguity": { "type": ["string", "null"] },
          "reviewIssue": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "fields", "values"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "missing-class-time",
                      "conflicting-class-time",
                      "conflicting-deadline",
                      "conflicting-release",
                      "ambiguous-evidence",
                      "other"
                    ]
                  },
                  "fields": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "enum": ["availableFrom", "dueAt", "eventEndsAt", "evidence"]
                    }
                  },
                  "values": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/reviewValue" }
                  }
                }
              }
            ]
          },
          "matchTaskId": { "type": ["string", "null"] },
          "logicalKey": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "dateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "value", "sourceIds"],
      "properties": {
        "state": { "type": "string", "enum": ["unknown", "value", "explicit-null"] },
        "value": {
          "type": ["string", "null"],
          "pattern": "^(?:\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T\\d{2}:\\d{2}(?::\\d{2}(?:\\.\\d{1,9})?)?(?:Z|[+-]\\d{2}:\\d{2}))$"
        },
        "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "value", "sourceIds"],
          "properties": {
            "state": { "type": "string", "const": "value" },
            "value": { "$ref": "#/$defs/machineDate" },
            "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "value", "sourceIds"],
          "properties": {
            "state": { "type": "string", "enum": ["unknown", "explicit-null"] },
            "value": { "type": "null" },
            "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      ]
    },
    "reviewValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "sourceId", "state", "value"],
      "properties": {
        "field": {
          "type": "string",
          "enum": ["availableFrom", "dueAt", "eventEndsAt", "evidence"]
        },
        "sourceId": { "type": "string" },
        "state": { "type": "string", "enum": ["unknown", "value", "explicit-null"] },
        "value": { "type": ["string", "null"] }
      },
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "sourceId", "state", "value"],
          "properties": {
            "field": {
              "type": "string",
              "enum": ["availableFrom", "dueAt", "eventEndsAt", "evidence"]
            },
            "sourceId": { "type": "string" },
            "state": { "type": "string", "const": "value" },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "sourceId", "state", "value"],
          "properties": {
            "field": {
              "type": "string",
              "enum": ["availableFrom", "dueAt", "eventEndsAt", "evidence"]
            },
            "sourceId": { "type": "string" },
            "state": { "type": "string", "enum": ["unknown", "explicit-null"] },
            "value": { "type": "null" }
          }
        }
      ]
    },
    "machineDate": {
      "type": "string",
      "pattern": "^(?:\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T\\d{2}:\\d{2}(?::\\d{2}(?:\\.\\d{1,9})?)?(?:Z|[+-]\\d{2}:\\d{2}))$"
    }
  }
}
